<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 450 100" width="100%" height="100%">
  <defs>
    <!-- Gradiente Violeta a Fucsia -->
    <linearGradient id="gradienteNav" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7c3aed" />
      <stop offset="100%" stop-color="#db2777" />
    </linearGradient>
  </defs>

  <!-- Simbolo Isotipo (Monograma AM Vectorial) -->
  <g transform="translate(10, 10)">
    <!-- Base de la A/M -->
    <path d="M 15 70 L 40 15 L 52 38 L 32 70 Z" fill="url(#gradienteNav)" />
    <path d="M 40 15 L 65 70 L 52 70 L 40 42 L 28 70 L 16 70 Z" fill="#0f172a" />
    <path d="M 52 38 L 77 70 L 64 70 L 52 48 Z" fill="url(#gradienteNav)" />
    
    <!-- Nodos Vectoriales (Puntos de ancla) -->
    <circle cx="40" cy="15" r="4" fill="#db2777" />
    <circle cx="15" cy="70" r="3.5" fill="#7c3aed" />
    <circle cx="77" cy="70" r="3.5" fill="#db2777" />
    <line x1="40" y1="15" x2="15" y2="70" stroke="#db2777" stroke-width="1" stroke-dasharray="2,2"/>
  </g>

  <!-- Texto del Nombre -->
  <text x="100" y="48" font-family="'Montserrat', sans-serif" font-weight="800" font-size="28" fill="#0f172a" letter-spacing="-0.5">
    AARÓN <tspan fill="url(#gradienteNav)">MASI</tspan>
  </text>
  
  <!-- Subtítulo / Especialidad -->
  <text x="100" y="70" font-family="'Poppins', sans-serif" font-weight="500" font-size="13" fill="#64748b" letter-spacing="1.5">
    DISEÑO GRÁFICO DIGITAL
  </text>
</svg>
